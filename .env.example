# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://<your_database_username_here>:<your_database_password_here>@localhost:5432/<your_database_name_here>"


NEXTAUTH_SECRET="your_next_auth_secret_key_here"
NEXTAUTH_URL=http://localhost:3001


REDIS_URL=redis://localhost:6379/0


# --- Email Service (Professional Mail SMTP) ---
MAIL_USERNAME="your_email_username_here"
MAIL_PASSWORD="your_email_password_here"
MAIL_FROM="your_email_here"
MAIL_FROM_NAME="Smart Mechanic Official"

# Professional Mail Outgoing Server Config
MAIL_SERVER="smtpout.secureserver.net"
# MAIL_PORT=587
# Or use SSL on Port 465 if preferred:
MAIL_PORT=465


# --- Initial Superadmin Setup ---
ADMIN_USERNAME="Admin"
ADMIN_EMAIL="your_admin_email_here"
ADMIN_PASSWORD="your_admin_password_here"


# Razorpay Credentials (from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"