# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://smartmechanic:replace-with-a-strong-url-safe-password@localhost:5432/smartmechanic?schema=public"
POSTGRES_USER="smartmechanic"
POSTGRES_PASSWORD="replace-with-a-strong-url-safe-password"
POSTGRES_DB="smartmechanic"
INTERNAL_DATABASE_URL="postgresql://smartmechanic:replace-with-a-strong-url-safe-password@db:5432/smartmechanic?schema=public"

NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL=http://localhost:3001


REDIS_URL=redis://localhost:6379/0


# --- Email Service (Professional Mail SMTP) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Smart Mechanic Official"

# Professional Mail Outgoing Server Config
MAIL_SERVER="smtpout.secureserver.net"
# MAIL_PORT=587
# Or use SSL on Port 465 if preferred:
MAIL_PORT=465


# --- Initial Superadmin Setup ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# Razorpay Credentials (from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=